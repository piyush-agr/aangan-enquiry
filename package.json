{
  "name": "aangan-enquiry",
  "version": "1.0.0",
  "private": true,
  "description": "Aangan Studio AI phone-enquiry system (MESA Case 03)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "data:purge": "tsx --conditions=react-server scripts/purge.ts",
    "check:bundle": "tsx --conditions=react-server scripts/check-bundle-leaks.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:bundle",
    "vercel-build": "tsx --conditions=react-server scripts/migrate.ts && tsx --conditions=react-server scripts/seed.ts --optional && next build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.26",
    "pg": "^8.16.3",
    "react": "^19.1.9",
    "react-dom": "^19.1.9",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.26",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "8.5.29"
  }
}
