# ─────────────────────────────────────────────────────────────────────────────
# Aangan Studio phone-enquiry system — environment variables
# Copy to .env for local development. NEVER commit a real .env.
# Every variable below is read by src/lib/config/env.ts (validated at startup).
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production
APP_ENV=development
# Public URL of this app. Used for the webhook URL shown in Settings and the
# (login-protected) enquiry link inside Telegram messages. Leave blank to omit links.
APP_BASE_URL=http://localhost:3000

# PostgreSQL connection string (local Postgres, or Supabase "Session pooler" URL in production)
DATABASE_URL=postgres://aangan:aangan_dev@localhost:5432/aangan_dev

# ≥ 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Time zone used for reporting (the studio is in Pune)
STUDIO_TIMEZONE=Asia/Kolkata

# ── Seed admin user (only read by `npm run db:seed`) ─────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Nikhil Deshpande

# ── Voice provider ──────────────────────────────────────────────────────────
# mock        → no phone line; use the in-app Call simulator (default)
# vaaniyantra → accept signed webhooks from VaaniYantra (https://vaaniyantra.com)
VOICE_PROVIDER=mock

# These names are this app's own. The VALUES come from your VaaniYantra workspace:
#  - API key: Settings → API keys (starts with ck_live_, needs scope calls:read)
#  - Webhook secret: Settings → Webhooks (starts with whsec_)
VAANIYANTRA_API_BASE_URL=https://vaaniyantra.com/api/v1
VAANIYANTRA_API_KEY=
VAANIYANTRA_WEBHOOK_SECRET=
# Optional: only accept events for this agent id
VAANIYANTRA_AGENT_ID=
# Reject webhook events whose `timestamp` is older than this (replay protection)
WEBHOOK_MAX_AGE_SECONDS=86400

# ── Telegram designer handoff ───────────────────────────────────────────────
# Bot token from @BotFather; chat id of the designers' group (negative number for groups)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNER_CHAT_ID=
# Optional separate chat for urgent existing-client escalations (defaults to the designer chat)
TELEGRAM_URGENT_CHAT_ID=
# true = also send simulator (demo) messages, clearly marked DEMO. Default false = preview only.
TELEGRAM_SEND_DEMO=false
TELEGRAM_API_BASE_URL=https://api.telegram.org

# ── Background job ──────────────────────────────────────────────────────────
# Bearer secret for /api/jobs/reprocess (Vercel Cron sends it automatically when set in the project)
CRON_SECRET=

# ── Data retention ──────────────────────────────────────────────────────────
# Transcripts and raw provider payloads older than this are removed by `npm run data:purge -- --apply`
DATA_RETENTION_DAYS=365

# ── Optional tuning ─────────────────────────────────────────────────────────
# Max Postgres connections per app instance (keep low on serverless)
DB_POOL_MAX=5
